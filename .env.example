# Copiar a web/.env.local en la fase 2. Nunca commitear valores reales.

# Avalanche Fuji (43113). Solo C-Chain si el mentor lo exige.
NEXT_PUBLIC_CHAIN_ID=43113

# Unlock Lock (fase 3) + contrato (fase 6)
NEXT_PUBLIC_UNLOCK_LOCK=
NEXT_PUBLIC_PROTOCOL_ADDRESS=
NEXT_PUBLIC_TOKEN_ADDRESS=

# Pollar: usar pub_testnet_ para sandbox; pub_mainnet_ solo para el pago de 1 USDC (fase 8).
# NO pongas sec_* aquí. La secret key va solo en backend si más adelante hace falta.
NEXT_PUBLIC_POLLAR_API_KEY=
NEXT_PUBLIC_POLLAR_DESTINO=

# Hardhat (raíz, no Next). Wallet A con AVAX Fuji.
# PRIVATE_KEY=
# SNOWTRACE_API_KEY=
